{
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node -e \"for (const f of ['local.db', 'local.db-wal', 'local.db-shm']) require('fs').rmSync(f, { force: true })\" && drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@libsql/client": "^0.18.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
